{
  "name": "proofbid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "build": "pnpm typecheck && pnpm --filter @proofbid/web build",
    "start": "node --env-file-if-exists=.env --import tsx scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write apps packages scripts tests *.json *.yaml",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "doctor": "tsx scripts/doctor.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:backup": "tsx scripts/db.ts backup",
    "verify:bundle": "tsx scripts/verify-bundle.ts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:coverage": "forge coverage --root contracts",
    "contracts:check": "forge fmt --root contracts --check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.7",
    "json-canonicalize": "^3.0.1",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
