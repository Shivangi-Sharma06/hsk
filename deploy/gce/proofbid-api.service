[Unit]
Description=ProofBid website and buyer API
After=network-online.target proofbid-vendors.service
Wants=network-online.target
Requires=proofbid-vendors.service
RequiresMountsFor=/srv/proofbid-data

[Service]
User=proofbid
Group=proofbid
WorkingDirectory=/opt/proofbid/current
EnvironmentFile=/etc/proofbid/app.env
Environment=PATH=/opt/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/node/bin/node --import tsx apps/api/src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/proofbid-data/app /var/lib/proofbid
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
